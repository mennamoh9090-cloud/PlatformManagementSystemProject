@model PlatformManagementSystem.MVC.ViewModels.Student.StudentDashboardVM

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-mortarboard-fill text-primary me-2"></i>Student Dashboard</h2>
    <a asp-action="ProgressChart" asp-controller="StudentDashboard" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="bi bi-graph-up me-1"></i> View Progress Chart
    </a>
</div>

<div class="row g-4 mb-5">
    <!-- Stat Cards -->
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <i class="bi bi-journal-album opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Total Courses</h6>
                <h2 class="fw-bold m-0">@Model.TotalCourses</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-success shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <i class="bi bi-check-circle opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Completed</h6>
                <h2 class="fw-bold m-0">@Model.CompletedCourses</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-warning shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-dark">
                <i class="bi bi-hourglass-split opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Pending</h6>
                <h2 class="fw-bold m-0">@Model.PendingCourses</h2>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mt-4 mb-3">My Courses</h4>
@if (Model.Courses != null && Model.Courses.Any())
{
    <div class="row g-4">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 mb-3">
                <div class="card p-4 shadow-sm border-0 rounded-4 h-100 hover-shadow transition">
                    <h5 class="fw-bold mb-3">@course.CourseTitle</h5>
                    
                    <!-- Progress Bar -->
                    <p class="small text-muted mb-1 d-flex justify-content-between">
                        <span>Progress</span>
                        <span class="fw-bold text-primary">@course.ProgressPercentage%</span>
                    </p>
                    <div class="progress mb-4" style="height: 10px; border-radius: 10px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                             role="progressbar"
                             style="width:@course.ProgressPercentage%">
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="mt-auto d-flex flex-wrap gap-2">
                        <a asp-action="StartLearning"
                           asp-controller="StudentDashboard"
                           asp-route-courseId="@course.CourseId"
                           class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-play-circle me-1"></i> Continue
                        </a>

                        <a asp-action="CourseDetails"
                           asp-controller="StudentDashboard"
                           asp-route-courseId="@course.CourseId"
                           class="btn btn-outline-secondary btn-sm flex-grow-1">
                            Details
                        </a>

                        @if (course.IsCompleted)
                        {
                            <a asp-action="Certificate"
                               asp-controller="StudentDashboard"
                               asp-route-courseId="@course.CourseId"
                               class="btn btn-success btn-sm w-100 mt-2">
                                <i class="bi bi-award me-1"></i> Download Certificate
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-light border border-secondary text-center py-5 rounded-4 shadow-sm">
        <i class="bi bi-journal-x text-muted mb-3 d-block" style="font-size: 3rem;"></i>
        <h5 class="fw-bold">No courses enrolled yet</h5>
        <p class="text-muted">Explore the platform to find a course that suits you.</p>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary px-4 mt-2">Browse Courses</a>
    </div>
}

<div class="row mt-5">
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-bar-chart-steps text-info me-2"></i>Course Progress</h5>
            </div>
            <div class="card-body">
                @if (Model.Progress != null && Model.Progress.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Progress)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-medium">@item.CourseTitle</span>
                                <span class="badge bg-primary rounded-pill">@item.ProgressPercentage%</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-3">No progress data yet.</p>
                }
            </div>
        </div>
    </div>
    
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-file-earmark-text text-warning me-2"></i>Exam Scores</h5>
            </div>
            <div class="card-body">
                @if (Model.ExamScores != null && Model.ExamScores.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var exam in Model.ExamScores)
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0 fw-bold">@exam.ExamTitle</h6>
                                        <small class="text-muted">@exam.CourseTitle</small>
                                    </div>
                                    <span class="badge bg-success rounded-pill fs-6 px-3">@exam.Score%</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-3">No exam results yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>