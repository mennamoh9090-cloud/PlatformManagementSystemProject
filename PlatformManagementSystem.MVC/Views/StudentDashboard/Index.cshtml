@model PlatformManagementSystem.MVC.ViewModels.Student.StudentDashboardVM
<h2 class="mb-4">Student Dashboard</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card bg-primary text-white p-3">
            <h5>Total Courses</h5>
            <h3>@Model.TotalCourses</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-success text-white p-3">
            <h5>Completed</h5>
            <h3>@Model.CompletedCourses</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-warning text-dark p-3">
            <h5>Pending</h5>
            <h3>@Model.PendingCourses</h3>
        </div>
    </div>
    <a asp-action="ProgressChart"
   asp-controller="StudentDashboard"
   class="btn btn-dark mt-4">
   View Progress Chart
</a>
</div>
<hr />
<h4 class="mt-4">My Courses</h4>

@if (Model.Courses != null && Model.Courses.Any())
{
    <div class="row">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 mb-3">
                <div class="card p-3 shadow-sm">

                    <h5>@course.CourseTitle</h5>

                    <!-- Progress Bar -->
                    <div class="progress mb-2">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width:@course.ProgressPercentage%">
                            @course.ProgressPercentage%
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">

                        <a asp-action="StartLearning"
                           asp-controller="StudentDashboard"
                           asp-route-courseId="@course.CourseId"
                           class="btn btn-primary btn-sm">
                            Start Learning
                        </a>

                        <a asp-action="CourseDetails"
                           asp-controller="StudentDashboard"
                           asp-route-courseId="@course.CourseId"
                           class="btn btn-info btn-sm">
                            Course Details
                        </a>

                        @if (course.IsCompleted)
                        {
                            <a asp-action="Certificate"
   asp-controller="StudentDashboard"
   asp-route-courseId="@course.CourseId"
   class="btn btn-success btn-sm">
    Download Certificate
</a>
                        }

                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <p>No courses enrolled yet.</p>
}
<hr />

<h4>Course Progress</h4>

@if (Model.Progress != null && Model.Progress.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Course</th>
                <th>Progress %</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Progress)
            {
                <tr>
                    <td>@item.CourseTitle</td>
                    <td>@item.ProgressPercentage %</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No progress data yet.</p>
}

<hr />

<h4>Exam Scores</h4>

@if (Model.ExamScores != null && Model.ExamScores.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Course</th>
                <th>Exam</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exam in Model.ExamScores)
            {
                <tr>
                    <td>@exam.CourseTitle</td>
                    <td>@exam.ExamTitle</td>
                    <td>@exam.Score</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No exam results yet.</p>
}