@using PlatformManagementSystem.MVC.ViewModels.Lesson
@model List<LessonViewModel>

<h2>Lessons</h2>

<a asp-action="Create" asp-route-courseId="@ViewBag.CourseId">
    Add Lesson
</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lesson in Model)
        {
            <tr>
                <td>@lesson.Title</td>
                <td>
                    <a asp-action="Delete"
                       asp-route-id="@lesson.Id"
                       asp-route-courseId="@ViewBag.CourseId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
