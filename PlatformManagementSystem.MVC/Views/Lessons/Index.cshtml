@using PlatformManagementSystem.MVC.ViewModels.Lesson
@model List<LessonViewModel>

@{
    Layout = "_InstructorLayout";
    ViewData["Title"] = "Manage Lessons";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-journal-text text-primary me-2"></i>Course Lessons</h2>
            <p class="text-muted mb-0 mt-1">Manage all lessons for this course</p>
        </div>
        <div>
            <a asp-action="Create" asp-route-courseId="@ViewBag.CourseId" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
                <i class="bi bi-plus-lg me-1"></i> Add New Lesson
            </a>
            <a asp-controller="InstructorDashboard" asp-action="ManageCourse" asp-route-courseId="@ViewBag.CourseId" class="btn btn-outline-secondary rounded-pill px-4 ms-2 fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Back to Course
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 p-5 text-center">
            <div class="card-body">
                <i class="bi bi-journal-x text-muted opacity-50 mb-3 d-block" style="font-size: 4rem;"></i>
                <h4 class="fw-bold">No Lessons Yet</h4>
                <p class="text-muted mb-4">This course currently has no lessons. Start adding content to engage your students.</p>
                <a asp-action="Create" asp-route-courseId="@ViewBag.CourseId" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-lg me-1"></i> Create First Lesson
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Lesson Title</th>
                            <th class="text-end pe-4 py-3" style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lesson in Model)
                        {
                            <tr>
                                <td class="ps-4 py-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                            <i class="bi bi-play-circle fs-5"></i>
                                        </div>
                                        <span class="fw-semibold">@lesson.Title</span>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Delete"
                                       asp-route-id="@lesson.Id"
                                       asp-route-courseId="@ViewBag.CourseId"
                                       class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                       onclick="return confirm('Are you sure you want to delete this lesson?');">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
