@using PlatformManagementSystem.MVC.ViewModels.Admin
@model List<AdminCourseVM>

@{
    ViewData["Title"] = "Manage Courses";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-book-half text-primary"></i> Course Moderation & Approvals</h2>
            <p class="text-muted mb-0">Review submitted courses, approve content for public enrollment, or moderate listings.</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">
            Total Courses: @Model.Count
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Course Title</th>
                            <th>Instructor</th>
                            <th>Students</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@course.Id</td>
                                    <td>
                                        <span class="fw-semibold">@course.Title</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-person text-secondary"></i> @course.InstructorName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            👨‍🎓 @course.StudentsCount
                                        </span>
                                    </td>
                                    <td>
                                        @if (course.StatusName == "Approved" || course.Status == 1)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle"></i> Approved
                                            </span>
                                        }
                                        else if (course.StatusName == "Rejected" || course.Status == 2)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle"></i> Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-hourglass-split"></i> Pending Review
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-controller="Courses" asp-route-id="@course.Id" target="_blank" class="btn btn-outline-secondary btn-sm" title="Preview Course">
                                                <i class="bi bi-eye"></i> View
                                            </a>

                                            @if (course.StatusName != "Approved" && course.Status != 1)
                                            {
                                                <form asp-action="ApproveCourse" asp-controller="AdminDashboard" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@course.Id" />
                                                    <button type="submit" class="btn btn-success btn-sm ms-1" title="Approve course for enrollment">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>
                                                </form>
                                            }

                                            @if (course.StatusName != "Rejected" && course.Status != 2)
                                            {
                                                <form asp-action="RejectCourse" asp-controller="AdminDashboard" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@course.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm ms-1" title="Reject course">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No courses registered on the platform yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
