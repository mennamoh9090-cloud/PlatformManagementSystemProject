@using PlatformManagementSystem.MVC.ViewModels.Admin
@model List<AdminCourseVM>

<h3>Courses</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Students</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.StudentsCount</td>
            </tr>
        }
    </tbody>
</table>
