@using PlatformManagementSystem.MVC.ViewModels.Admin
@model AdminStatsVM

<h2 class="fw-bold mb-4">Admin Dashboard</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card bg-gradient shadow border-0 p-4 text-center">
            <h6>Total Users</h6>
            <h2>@Model.TotalUsers</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-gradient shadow border-0 p-4 text-center">
            <h6>Total Courses</h6>
            <h2>@Model.TotalCourses</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-gradient shadow border-0 p-4 text-center">
            <h6>Enrollments</h6>
            <h2>@Model.TotalEnrollments</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-gradient shadow border-0 p-4 text-center">
            <h6>Exams</h6>
            <h2>@Model.TotalExams</h2>
        </div>
    </div>

</div>