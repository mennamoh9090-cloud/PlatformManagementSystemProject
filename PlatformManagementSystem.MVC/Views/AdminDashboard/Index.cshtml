@using PlatformManagementSystem.MVC.ViewModels.Admin
@model AdminStatsVM

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-speedometer2 text-primary me-2"></i>Admin Dashboard</h2>
</div>

<div class="row g-4 mb-5">
    <!-- Stat Cards -->
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <i class="bi bi-people opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Total Users</h6>
                <h2 class="fw-bold m-0">@Model.TotalUsers</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <i class="bi bi-journal-text opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Total Courses</h6>
                <h2 class="fw-bold m-0">@Model.TotalCourses</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-info shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-dark">
                <i class="bi bi-person-check opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Enrollments</h6>
                <h2 class="fw-bold m-0">@Model.TotalEnrollments</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-warning shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-dark">
                <i class="bi bi-pencil-square opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Exams</h6>
                <h2 class="fw-bold m-0">@Model.TotalExams</h2>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-3">Quick Actions</h4>
<div class="row g-4">
    <!-- Manage Users Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 text-center hover-shadow transition">
            <div class="card-body py-5">
                <i class="bi bi-people-fill text-primary" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3">Manage Users</h5>
                <p class="text-muted small">View all registered users safely and delete them if necessary.</p>
                <a asp-action="Users" class="btn btn-primary rounded-pill mt-2 px-4">Go to Users</a>
            </div>
        </div>
    </div>

    <!-- Manage Roles Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 text-center hover-shadow transition">
            <div class="card-body py-5">
                <i class="bi bi-shield-lock-fill text-success" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3">Manage Roles</h5>
                <p class="text-muted small">Create new roles, assign them to users, and control access levels.</p>
                <a asp-action="Roles" class="btn btn-success rounded-pill mt-2 px-4">Go to Roles</a>
            </div>
        </div>
    </div>

    <!-- Manage Courses Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 text-center hover-shadow transition">
            <div class="card-body py-5">
                <i class="bi bi-book-half text-info" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3">Manage Courses</h5>
                <p class="text-muted small">Overview of all platform courses and ability to moderate/delete.</p>
                <a asp-action="Courses" class="btn btn-info text-white rounded-pill mt-2 px-4">Go to Courses</a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>