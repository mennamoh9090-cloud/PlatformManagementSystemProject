@using PlatformManagementSystem.MVC.Resources
@using PlatformManagementSystem.MVC.ViewModels.Admin
@model List<AdminUserVM>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
<h2>@Localizer["Dashboard"]</h2>
<h3>Users</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    <a asp-action="DeleteUser"
                       asp-route-id="@user.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>