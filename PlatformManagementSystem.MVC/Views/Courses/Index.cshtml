@using PlatformManagementSystem.MVC.ViewModels.Course
@model List<CourseViewModel>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Explore Courses</h2>
        <p class="text-muted mb-0">
            @{
                var search = (string)(ViewBag.Search ?? string.Empty);
            }
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <span>Results for "<strong>@search</strong>" — </span>
            }
            <span>@Model.Count course@(Model.Count != 1 ? "s" : "") available</span>
        </p>
    </div>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="text-center py-5">
                <i class="bi bi-search fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No courses found</h5>
                <p class="text-muted small">Try a different search term</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var course in Model)
        {
            <div class="col-12 col-md-4">
                <div class="course-card h-100">

                    <!-- Image -->
                    <div class="course-card-img-wrap">
                        <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "/images/default-course.jpg" : course.ThumbnailUrl)"
                             alt="@course.Title" />
                        <div class="course-price-badge">$@course.Price</div>
                    </div>

                    <!-- Body -->
                    <div class="course-card-body">
                        <h6 class="course-card-title">@course.Title</h6>

                        <div class="course-card-meta">
                            <i class="bi bi-person-circle"></i>
                            <span>@course.InstructorName</span>
                        </div>

                        <div class="course-card-stars">
                            <span class="text-warning">★★★★☆</span>
                            <span class="text-muted small ms-1">4.0</span>
                        </div>

                        <div class="course-card-footer">
                            <a asp-controller="Courses"
                               asp-action="Details"
                               asp-route-id="@course.Id"
                               class="course-btn-details">
                                <i class="bi bi-eye"></i> Details
                            </a>

                            @if (Context.Session.GetString("UserToken") != null)
                            {
                                @if (course.IsEnrolled)
                                {
                                    <span class="course-btn-enrolled">
                                        <i class="bi bi-check-circle-fill"></i> Enrolled
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="Enroll" method="post" class="d-inline">
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="course-btn-enroll">
                                            <i class="bi bi-plus-lg"></i> Enroll
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    }
</div>
