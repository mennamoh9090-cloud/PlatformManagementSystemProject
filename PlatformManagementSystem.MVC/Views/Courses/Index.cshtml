@using PlatformManagementSystem.MVC.ViewModels.Course
@model List<CourseViewModel>

<h2 class="mb-4 fw-bold">Explore Courses</h2>

<div class="row">
    @foreach (var course in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 course-card">

                <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl)
                                     ? "/images/default-course.jpg"
                                     : course.ThumbnailUrl)"
                 class="card-img-top"
                 style="height:180px; object-fit:cover;" />

                <div class="card-body">
                    <h6 class="fw-bold">@course.Title</h6>

                    <p class="text-muted small mb-1">
                        @course.InstructorName
                    </p>

                    <div class="mb-2 text-warning">
                        ★★★★☆
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">$@course.Price</span>
                        <div class="mt-3">
                        @if (course.IsEnrolled)
                        {
                            <span class="badge bg-success">Already Enrolled</span>
                        }
                        else
                        {
                            <form asp-action="Enroll" method="post">
                                <input type="hidden" name="courseId" value="@course.Id" />
                                <button type="submit" class="btn btn-dark w-100">
                                    Add To My Courses
                                </button>
                            </form>
                        }
                        </div>
                        <a asp-controller="Courses"
                           asp-action="Details"
                           asp-route-id="@course.Id"
                           class="btn btn-sm btn-dark">
                            View
                        </a>
                    </div>
                </div>

            </div>
        </div>
        }
</div>