@model List<PlatformManagementSystem.MVC.ViewModels.Course.CourseViewModel>
@{
    ViewData["Title"] = "Home";
    var featured = Model?.Take(6).ToList() ?? new List<PlatformManagementSystem.MVC.ViewModels.Course.CourseViewModel>();
}
<div class="home-page-wrap">
<!-- Hero -->
<section class="home-hero">
    <div class="home-hero-overlay"></div>
    <div class="container position-relative">
        <div class="row align-items-center justify-content-center min-vh-75">
            <div class="col-lg-7 text-center">
                <h1 class="home-hero-title fade-in-up">Upgrade Your Skills Today</h1>
                <p class="home-hero-lead fade-in-up delay-1">Learn from experts and build real-world projects with hands-on courses and live sessions.</p>
                <div class="d-flex flex-wrap gap-3 mt-4 justify-content-center">
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-hero-primary btn-lg px-4 py-3 fade-in-up delay-2">Browse Courses</a>
                    @if (Context.Session.GetString("UserToken") == null)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-hero-outline btn-lg px-4 py-3 fade-in-up delay-3">Get Started Free</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats -->
<section class="home-stats py-4">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="home-stat-item">
                    <span class="home-stat-value">@(Model?.Count ?? 0)</span>
                    <span class="home-stat-label">Courses</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="home-stat-item">
                    <span class="home-stat-value">Live</span>
                    <span class="home-stat-label">Sessions</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="home-stat-item">
                    <span class="home-stat-value">24/7</span>
                    <span class="home-stat-label">Access</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="home-stat-item">
                    <span class="home-stat-value">100%</span>
                    <span class="home-stat-label">Certified</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses -->
<section class="home-courses py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="home-section-title">Featured Courses</h2>
            <p class="home-section-subtitle text-muted">Start learning with our most popular courses</p>
        </div>
        @if (featured.Any())
        {
            <div class="row g-4">
                @foreach (var course in featured)
                {
                    <div class="col-lg-4 col-md-6">
                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="text-decoration-none text-dark">
                            <div class="home-course-card">
                                <div class="home-course-card-img-wrap">
                                    <img src="@(string.IsNullOrWhiteSpace(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&h=350&fit=crop" : course.ThumbnailUrl)"
                                         alt="@course.Title"
                                         class="home-course-card-img" />
                                    <span class="home-course-card-badge">Course</span>
                                </div>
                                <div class="home-course-card-body">
                                    <h5 class="home-course-card-title">@course.Title</h5>
                                    <p class="home-course-card-meta">@(string.IsNullOrWhiteSpace(course.InstructorName) ? "Instructor" : course.InstructorName)</p>
                                    <p class="home-course-card-desc">@(course.Description != null && course.Description.Length > 80 ? course.Description.Substring(0, 80) + "…" : (course.Description ?? ""))</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="home-course-card-price">$@course.Price.ToString("N0")</span>
                                        <span class="btn btn-sm btn-outline-primary">View</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <div class="text-center mt-5">
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg px-4">View All Courses</a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted mb-4">No courses yet. Check back soon or create one as an instructor.</p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">Browse Courses</a>
            </div>
        }
    </div>
</section>

<!-- Why Us -->
<section class="home-why py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="home-section-title">Why Learn With Us?</h2>
            <p class="home-section-subtitle text-muted">Everything you need to grow your career</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="home-why-card text-center p-4 h-100">
                    <div class="home-why-icon mb-3"><i class="bi bi-person-video3"></i></div>
                    <h5 class="fw-bold">Expert Instructors</h5>
                    <p class="text-muted mb-0">Learn from industry professionals with real-world experience.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="home-why-card text-center p-4 h-100">
                    <div class="home-why-icon mb-3"><i class="bi bi-broadcast"></i></div>
                    <h5 class="fw-bold">Live Sessions & Board</h5>
                    <p class="text-muted mb-0">Join live classes and collaborate on the shared whiteboard.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="home-why-card text-center p-4 h-100">
                    <div class="home-why-icon mb-3"><i class="bi bi-award"></i></div>
                    <h5 class="fw-bold">Certification</h5>
                    <p class="text-muted mb-0">Earn certificates to boost your resume and career.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="home-cta py-5">
    <div class="container text-center">
        <h2 class="home-cta-title mb-3">Ready to Start Learning?</h2>
        <p class="home-cta-text text-white-50 mb-4">Join thousands of learners and upgrade your skills today.</p>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-light btn-lg px-4 py-3">Explore Courses</a>
    </div>
</section>

<style>
    @@keyframes fadeInUp {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }

    .min-vh-75 { min-height: 75vh; }
    .home-hero {
        position: relative;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        background: linear-gradient(135deg, #1e3a5f 0%, #0d1b2a 100%);
        background-image: url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1920&q=80');
        background-size: cover;
        background-position: center;
        color: #fff;
    }
    .home-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(30,58,95,0.92) 0%, rgba(13,27,42,0.95) 100%);
    }
    .home-hero-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1rem;
        background: linear-gradient(to right, #ffffff, #e2e8f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0px 4px 12px rgba(0,0,0,0.1);
    }
    .home-hero-lead {
        font-size: 1.15rem;
        opacity: 0.95;
        max-width: 540px;
        margin-left: auto;
        margin-right: auto;
    }
    .btn-hero-primary {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border: none;
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
        transition: transform 0.3s, box-shadow 0.3s;
    }
    .btn-hero-primary:hover { 
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(245, 158, 11, 0.6);
        color: #fff; 
    }
    .btn-hero-outline {
        border: 2px solid rgba(255,255,255,0.8);
        color: #fff;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(5px);
        transition: transform 0.3s, background 0.3s;
    }
    .btn-hero-outline:hover { 
        background: rgba(255,255,255,0.15); 
        color: #fff; 
        border-color: #fff; 
        transform: translateY(-3px);
    }

    .home-stats { background: #f8fafc; }
    .home-stat-item {
        display: flex;
        flex-direction: column;
        padding: 1rem;
    }
    .home-stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1e3a5f;
    }
    .home-stat-label { font-size: 0.9rem; color: #64748b; }

    .home-section-title { font-size: 2rem; font-weight: 700; }
    .home-section-subtitle { font-size: 1rem; }

    .home-course-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.02);
    }
    .home-course-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    }
    .home-course-card-img-wrap { position: relative; overflow: hidden; }
    .home-course-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .home-course-card:hover .home-course-card-img { transform: scale(1.05); }
    .home-course-card-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #1e3a5f;
        color: #fff;
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 20px;
    }
    .home-course-card-body { padding: 1.25rem; }
    .home-course-card-title {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.35rem;
    }
    .home-course-card-meta { font-size: 0.85rem; color: #64748b; margin-bottom: 0.5rem; }
    .home-course-card-desc { font-size: 0.9rem; color: #475569; margin-bottom: 0; }
    .home-course-card-price { font-weight: 700; color: #1e3a5f; }

    .home-why { background: #f8fafc; }
    .home-why-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.02);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .home-why-card:hover { 
        transform: translateY(-8px); 
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    }
    .home-why-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto;
        background: linear-gradient(135deg, #1e3a5f, #0d1b2a);
        color: #fff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .home-cta {
        background: linear-gradient(135deg, #1e3a5f 0%, #0d1b2a 100%);
        border-radius: 24px;
        color: #fff;
        box-shadow: 0 20px 40px rgba(13, 27, 42, 0.2);
    }
    .home-cta-title { font-weight: 800; font-size: 2.25rem; }
    .home-cta-text { font-size: 1.05rem; }

    .home-page-wrap { overflow-x: hidden; }
</style>
</div>
