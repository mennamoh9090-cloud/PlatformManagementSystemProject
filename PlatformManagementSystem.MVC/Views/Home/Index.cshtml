@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero-section text-white d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="fw-bold display-4">Upgrade Your Skills Today</h1>
                <p class="lead mt-3">
                    Learn from  experts and build real-world projects.
                </p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-warning btn-lg mt-3 px-4">
                    Browse Courses
                </a>
            </div>
        </div>
    </div>
</section>

<!-- TRENDING COURSES -->
<section class="container py-5">
    <h2 class="fw-bold mb-4">Trending Courses</h2>

    <div class="row g-4">

        <!-- Course 1 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="course-card shadow-sm h-100">
                <img src="https://source.unsplash.com/600x350/?programming"
                     class="img-fluid w-100">
                <div class="p-3">
                    <h6 class="fw-bold">ASP.NET Core Mastery</h6>
                    <p class="text-muted small">John Smith</p>
                    <p class="fw-bold text-dark">$49.99</p>
                </div>
            </div>
        </div>

        <!-- Course 2 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="course-card shadow-sm h-100">
                <img src="https://source.unsplash.com/600x350/?design"
                     class="img-fluid w-100">
                <div class="p-3">
                    <h6 class="fw-bold">UI/UX Professional</h6>
                    <p class="text-muted small">Sarah Johnson</p>
                    <p class="fw-bold text-dark">$39.99</p>
                </div>
            </div>
        </div>

        <!-- Course 3 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="course-card shadow-sm h-100">
                <img src="https://source.unsplash.com/600x350/?artificial-intelligence"
                     class="img-fluid w-100">
                <div class="p-3">
                    <h6 class="fw-bold">Artificial Intelligence Fundamentals</h6>
                    <p class="text-muted small">Michael Brown</p>
                    <p class="fw-bold text-dark">$59.99</p>
                </div>
            </div>
        </div>

        <!-- Course 4 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="course-card shadow-sm h-100">
                <img src="https://source.unsplash.com/600x350/?data-science"
                     class="img-fluid w-100">
                <div class="p-3">
                    <h6 class="fw-bold">Data Science & Machine Learning</h6>
                    <p class="text-muted small">Emily Davis</p>
                    <p class="fw-bold text-dark">$69.99</p>
                </div>
            </div>
        </div>

        <!-- Course 5 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="course-card shadow-sm h-100">
                <img src="https://source.unsplash.com/600x350/?cyber-security"
                     class="img-fluid w-100">
                <div class="p-3">
                    <h6 class="fw-bold">Cyber Security Bootcamp</h6>
                    <p class="text-muted small">David Wilson</p>
                    <p class="fw-bold text-dark">$44.99</p>
                </div>
            </div>
        </div>

        <!-- Course 6 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="course-card shadow-sm h-100">
                <img src="https://source.unsplash.com/600x350/?mobile-development"
                     class="img-fluid w-100">
                <div class="p-3">
                    <h6 class="fw-bold">Flutter Mobile App Development</h6>
                    <p class="text-muted small">Sophia Martinez</p>
                    <p class="fw-bold text-dark">$54.99</p>
                </div>
            </div>
        </div>

    </div>
</section>
<!-- WHY US -->
<section class="bg-light py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Why Learn With Us?</h2>
        <div class="row">
            <div class="col-md-4">
                <h5 class="fw-bold">Expert Instructors</h5>
                <p class="text-muted">Learn from real industry professionals.</p>
            </div>
            <div class="col-md-4">
                <h5 class="fw-bold">Lifetime Access</h5>
                <p class="text-muted">Access your courses anytime.</p>
            </div>
            <div class="col-md-4">
                <h5 class="fw-bold">Certification</h5>
                <p class="text-muted">Earn certificates to boost your career.</p>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        height: 85vh;
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f');
        background-size: cover;
        background-position: center;
    }

    .course-card {
        border-radius: 12px;
        overflow: hidden;
        transition: 0.3s;
        background: white;
    }

        .course-card:hover {
            transform: translateY(-5px);
        }
</style>