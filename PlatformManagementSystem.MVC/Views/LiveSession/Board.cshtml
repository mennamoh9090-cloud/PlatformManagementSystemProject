@{
    ViewData["Title"] = "Live Board";
}

<div class="live-container">
    <h2 class="mb-3">Live Board</h2>
    <div class="row g-3">
        <div class="col-lg-9">
            <canvas id="whiteboard" width="1100" height="620" class="border rounded bg-white w-100"></canvas>
            <div class="d-flex gap-2 mt-2">
                <select id="tool" class="form-select w-auto">
                    <option value="freehand">Freehand</option>
                    <option value="rectangle">Rectangle</option>
                    <option value="circle">Circle</option>
                    <option value="line">Line</option>
                    <option value="arrow">Arrow</option>
                    <option value="text">Text</option>
                    <option value="eraser">Eraser</option>
                </select>
                <input type="color" id="colorPicker" class="form-control form-control-color" />
                <input type="range" id="brushSize" class="form-range w-auto" min="1" max="20" value="3" />
                <button class="btn btn-outline-secondary" onclick="undo()">Undo</button>
                <button class="btn btn-outline-secondary" onclick="redo()">Redo</button>
                <button class="btn btn-outline-danger" onclick="clearBoard()">Clear</button>
                <button class="btn btn-outline-primary" onclick="saveImage()">Save</button>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card h-100">
                <div class="card-header">Live Chat</div>
                <div class="card-body d-flex flex-column">
                    <div id="messages" class="flex-grow-1 overflow-auto mb-3" style="max-height: 500px;"></div>
                    <div class="input-group">
                        <input type="text" id="messageInput" class="form-control" placeholder="Type message..." />
                        <button class="btn btn-primary" type="button" id="sendBtn">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        window.sessionId = @((int)(ViewBag.SessionId ?? 0));
        window.userToken = "@ViewBag.Token";
        window.apiBaseUrl = "https://localhost:7102";

        const chatConnection = new signalR.HubConnectionBuilder()
            .withUrl(`${window.apiBaseUrl}/liveboardHub`, {
                accessTokenFactory: () => window.userToken
            })
            .build();

        chatConnection.start().then(() => {
            chatConnection.invoke("JoinSessionGroup", window.sessionId);
        });

        document.getElementById("sendBtn").addEventListener("click", () => {
            const input = document.getElementById("messageInput");
            const message = input.value.trim();
            if (!message) return;
            chatConnection.invoke("SendMessage", window.sessionId, message);
            input.value = "";
        });

        chatConnection.on("ReceiveMessage", (user, message) => {
            const item = document.createElement("div");
            item.className = "mb-2";
            item.innerHTML = `<strong>${user ?? "User"}:</strong> ${message}`;
            document.getElementById("messages").appendChild(item);
        });
    </script>
    <script src="~/js/whiteboard.js"></script>
}