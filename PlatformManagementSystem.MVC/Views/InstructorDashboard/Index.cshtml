@model PlatformManagementSystem.MVC.ViewModels.InstructorDashboard.InstructorDashboardVM

@{
    Layout = "_InstructorLayout";
}

<h3 class="mb-4">Dashboard Overview</h3>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card bg-primary text-white p-4 shadow-sm">
            <h6>Total Courses</h6>
            <h2>@Model.TotalCourses</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-success text-white p-4 shadow-sm">
            <h6>Total Students</h6>
            <h2>@Model.TotalStudents</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-warning text-dark p-4 shadow-sm">
            <h6>Live Sessions</h6>
            <h2>@Model.TotalLiveSessions</h2>
        </div>
    </div>

</div>

<h4 class="mb-3">My Courses</h4>

@if (Model.MyCourses != null && Model.MyCourses.Any())
{
    <div class="row">
        @foreach (var course in Model.MyCourses)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card p-3 shadow-sm">

                    <h5>@course.Title</h5>
                    <p class="text-muted small">
                        @course.Description
                    </p>

                    <div class="d-flex justify-content-between mt-3">
                        <span>👩‍🎓 @course.StudentCount Students</span>
                        <span>📚 @course.LessonsCount Lessons</span>
                    </div>

                    <a asp-action="ManageCourse"
                       asp-route-courseId="@course.CourseId"
                       class="btn btn-dark mt-3 w-100">
                        Manage Course
                    </a>

                </div>
            </div>
        }
    </div>

    <h4 class="mt-5 mb-3">Students Per Course</h4>
    <canvas id="coursesChart" height="100"></canvas>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            var courseNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MyCourses.Select(c => c.Title)));
            var studentCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MyCourses.Select(c => c.StudentCount)));

            var ctx = document.getElementById('coursesChart').getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: courseNames,
                    datasets: [{
                        label: 'Students',
                        data: studentCounts
                    }]
                }
            });
        </script>
    }
}
else
{
    <div class="alert alert-info">
        You haven't created any courses yet.
    </div>
}