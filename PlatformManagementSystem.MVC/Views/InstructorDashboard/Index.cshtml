@model PlatformManagementSystem.MVC.ViewModels.InstructorDashboard.InstructorDashboardVM

@{
    Layout = "_InstructorLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-person-video3 text-primary me-2"></i>Instructor Dashboard</h2>
    <a asp-controller="InstructorDashboard" asp-action="CreateCourse" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Create New Course
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <i class="bi bi-journal-check opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Total Courses</h6>
                <h2 class="fw-bold m-0">@Model.TotalCourses</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-success shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <i class="bi bi-people-fill opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Total Students</h6>
                <h2 class="fw-bold m-0">@Model.TotalStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-warning shadow border-0 h-100 p-3 rounded-4">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-dark">
                <i class="bi bi-broadcast opacity-50 mb-2" style="font-size: 2.5rem;"></i>
                <h6 class="text-uppercase fw-semibold mb-1">Live Sessions</h6>
                <h2 class="fw-bold m-0">@Model.TotalLiveSessions</h2>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-3">My Courses</h4>

@if (Model.MyCourses != null && Model.MyCourses.Any())
{
    <div class="row g-4 mb-5">
        @foreach (var course in Model.MyCourses)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 p-4 shadow-sm border-0 rounded-4 hover-shadow transition">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold text-dark mb-0">@course.Title</h5>
                        @if(course.Status == PlatformManagementSystem.Domain.Enums.CourseStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if(course.Status == PlatformManagementSystem.Domain.Enums.CourseStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </div>
                    <p class="text-muted small mb-4" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        @course.Description
                    </p>

                    <div class="d-flex justify-content-between mb-4 border-top pt-3 mt-auto">
                        <div class="text-center">
                            <i class="bi bi-people-fill text-primary fs-5 d-block mb-1"></i>
                            <span class="fw-bold">@course.StudentCount</span>
                            <span class="small text-muted d-block">Students</span>
                        </div>
                        <div class="text-center">
                            <i class="bi bi-journal-text text-success fs-5 d-block mb-1"></i>
                            <span class="fw-bold">@course.LessonsCount</span>
                            <span class="small text-muted d-block">Lessons</span>
                        </div>
                    </div>

                    <a asp-action="ManageCourse"
                       asp-route-courseId="@course.CourseId"
                       class="btn btn-outline-primary mt-auto w-100 rounded-pill">
                        <i class="bi bi-gear me-1"></i> Manage Course
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-0 pt-4 pb-0">
            <h5 class="fw-bold"><i class="bi bi-bar-chart-fill text-info me-2"></i>Students Per Course</h5>
        </div>
        <div class="card-body">
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="coursesChart"></canvas>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            var courseNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MyCourses.Select(c => c.Title)) ?? "[]");
            var studentCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MyCourses.Select(c => c.StudentCount)) ?? "[]");

            var ctx = document.getElementById('coursesChart').getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: courseNames,
                    datasets: [{
                        label: 'Enrolled Students',
                        data: studentCounts,
                        backgroundColor: 'rgba(99, 102, 241, 0.6)',
                        borderColor: 'rgb(79, 70, 229)',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { borderDash: [2, 4] } },
                        x: { grid: { display: false } }
                    }
                }
            });
        </script>
    }
}
else
{
    <div class="alert alert-light border border-secondary text-center py-5 rounded-4 shadow-sm">
        <i class="bi bi-folder-x text-muted mb-3 d-block" style="font-size: 3rem;"></i>
        <h5 class="fw-bold">You haven't created any courses yet.</h5>
        <p class="text-muted">Start sharing your knowledge by creating your first course.</p>
        <a asp-action="CreateCourse" class="btn btn-primary px-4 mt-2">
            <i class="bi bi-plus-lg me-1"></i> Create Course
        </a>
    </div>
}

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>