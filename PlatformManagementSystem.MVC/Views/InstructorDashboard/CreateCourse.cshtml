@model PlatformManagementSystem.MVC.ViewModels.InstructorDashboard.CreateCourseVM
@{
    Layout = "_InstructorLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 border-0">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-journal-plus me-2"></i>Create a New Course</h3>
                    <p class="mb-0 text-white-50 mt-1">Fill in the details below to publish your next great learning experience.</p>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="CreateCourse" method="post">
                        
                        <!-- Title Field -->
                        <div class="form-floating mb-4">
                            <input asp-for="Title" class="form-control bg-light border-0" id="floatingTitle" placeholder="Course Title" />
                            <label for="floatingTitle" class="text-muted"><i class="bi bi-type me-1"></i> Course Title</label>
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Category & Price Row -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select bg-light border-0" id="floatingCategory">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <label for="floatingCategory" class="text-muted"><i class="bi bi-tags me-1"></i> Category</label>
                                    <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Price" type="number" step="0.01" class="form-control bg-light border-0" id="floatingPrice" placeholder="0.00" />
                                    <label for="floatingPrice" class="text-muted"><i class="bi bi-currency-dollar me-1"></i> Price ($)</label>
                                    <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Thumbnail URL -->
                        <div class="form-floating mb-4">
                            <input asp-for="ThumbnailUrl" class="form-control bg-light border-0" id="floatingThumbnail" placeholder="https://..." />
                            <label for="floatingThumbnail" class="text-muted"><i class="bi bi-image me-1"></i> Thumbnail Image URL (Optional)</label>
                            <span asp-validation-for="ThumbnailUrl" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Description Field -->
                        <div class="form-floating mb-5">
                            <textarea asp-for="Description" class="form-control bg-light border-0" id="floatingDesc" placeholder="Description" style="height: 150px"></textarea>
                            <label for="floatingDesc" class="text-muted"><i class="bi bi-text-paragraph me-1"></i> Detailed Description</label>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <hr class="text-muted opacity-25 mb-4" />

                        <!-- Actions -->
                        <div class="d-flex gap-3 justify-content-end">
                            <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill fw-medium">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-cloud-arrow-up me-2"></i>Publish Course
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 .25rem rgba(13,110,253,.15);
            background-color: #fff !important;
        }
    </style>
}