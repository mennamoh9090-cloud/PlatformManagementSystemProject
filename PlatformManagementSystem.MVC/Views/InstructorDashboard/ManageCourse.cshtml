@using PlatformManagementSystem.MVC.ViewModels.InstructorDashboard
@model CourseDetailsVM

<div class="container mt-5">

    <h2>@Model.Title</h2>
    <p>@Model.Description</p>

    <hr />

    <h4>Lessons</h4>

    <a asp-controller="Lessons"
       asp-action="Create"
       asp-route-courseId="@Model.Id"
       class="btn btn-primary mb-3">
        Add Lesson
    </a>

    <a asp-controller="LiveSession"
       asp-action="ByCourse"
       asp-route-courseId="@Model.Id"
       class="btn btn-outline-success mb-3 ms-2">
        Live Sessions
    </a>

    <ul class="list-group">
        @foreach (var lesson in Model.Lessons)
        {
            <li class="list-group-item">
                @lesson.Title
            </li>
        }
    </ul>

</div>