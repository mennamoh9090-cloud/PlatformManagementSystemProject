@using PlatformManagementSystem.MVC.ViewModels.Exam
@model List<QuestionViewModel>

<h2>Manage Questions</h2>

<table class="table">
    <thead>
        <tr>
            <th>Question</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var q in Model)
        {
            <tr>
                <td>@q.Text</td>
                <td>
                    <a asp-action="EditQuestion" asp-route-questionId="@q.Id"
                       class="btn btn-warning">Edit</a>

                    <form asp-action="DeleteQuestion" method="post" style="display:inline">
                        <input type="hidden" name="questionId" value="@q.Id" />
                        <input type="hidden" name="examId" value="@q.ExamId" />
                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
}
