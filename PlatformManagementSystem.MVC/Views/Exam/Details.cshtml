@model PlatformManagementSystem.MVC.ViewModels.Exam.ExamDetailsViewModel

<h2>@Model.Title</h2>

<form method="post" asp-action="Submit">

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        <div class="mb-3">
            <h5>@Model.Questions[i].QuestionText</h5>

            }
        </div>
    }

    <button type="submit" class="btn btn-success">
        Submit Exam
    </button>

</form>
